{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.bsam-agent.invalid/schemas/capability-registry.schema.json",
  "title": "BSAM capability registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "registry_version",
    "target",
    "policy",
    "evidence",
    "top_level_blocks",
    "cluster_commands",
    "nested_constructs",
    "generation_profiles",
    "transformations",
    "obsolete_tokens",
    "execution_contract",
    "dependency_contract",
    "entity_contract",
    "change_contract",
    "consumer_contract",
    "repository_check_contract"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/capability-registry.schema.json"
    },
    "schema_version": {
      "const": "2.2.0"
    },
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "top_level_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "cluster_commands": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "nested_constructs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nestedConstruct"
      }
    },
    "generation_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/generationProfile" }
    },
    "transformations": {
      "type": "array",
      "items": { "$ref": "#/$defs/transformation" }
    },
    "obsolete_tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/obsoleteToken" }
    },
    "execution_contract": {
      "$ref": "#/$defs/executionContract"
    },
    "dependency_contract": {
      "$ref": "#/$defs/dependencyContract"
    },
    "entity_contract": {
      "$ref": "#/$defs/entityContract"
    },
    "change_contract": {
      "$ref": "#/$defs/changeContract"
    },
    "consumer_contract": {
      "$ref": "#/$defs/consumerContract"
    },
    "repository_check_contract": {
      "$ref": "#/$defs/repositoryCheckContract"
    }
  },
  "$defs": {
    "coverage": {
      "enum": [
        "identified",
        "partially-documented",
        "documented",
        "runtime-verified"
      ]
    },
    "operationStatus": {
      "enum": ["unassessed", "unsupported", "implemented", "verified"]
    },
    "dependencyContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "classes", "reference_contracts", "decision_sources", "clarification_triggers"],
      "properties": {
        "schema_version": { "const": "1.2.0" },
        "classes": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/dependencyClass" }
        },
        "reference_contracts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referenceContract" }
        },
        "decision_sources": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/decisionSource" }
        },
        "clarification_triggers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/clarificationTrigger" }
        }
      }
    },
    "dependencyClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "representation", "summary", "reference_kinds", "change_policy"],
      "properties": {
        "id": { "enum": ["structural-reference", "bsam-semantic-constraint", "engineering-decision"] },
        "representation": { "enum": ["semantic-reference", "semantic-reference-and-validator", "required-choice"] },
        "summary": { "type": "string", "minLength": 1 },
        "reference_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "change_policy": { "type": "string", "minLength": 1 }
      }
    },
    "referenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "classification", "source_entity_kinds", "target_entity_kinds", "forward_policy", "reverse_policy"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "classification": { "enum": ["structural-reference", "bsam-semantic-constraint"] },
        "source_entity_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "target_entity_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "forward_policy": { "type": "string", "minLength": 1 },
        "reverse_policy": { "type": "string", "minLength": 1 }
      }
    },
    "decisionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requires_user_input", "summary"],
      "properties": {
        "id": { "enum": ["user-approved", "source-derived"] },
        "requires_user_input": { "type": "boolean" },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "clarificationTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope_ids", "operations", "condition", "required_choices", "decision_source"],
      "properties": {
        "id": { "type": "string", "pattern": "^clarification\\.[a-z0-9-]+$" },
        "scope_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["create", "modify", "generate", "transform", "run"] }
        },
        "condition": { "type": "string", "minLength": 1 },
        "required_choices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision_source": { "const": "user-approved" }
      }
    },
    "entityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability_record_policy", "primary_entity_field", "no_primary_entity_capabilities", "additional_entity_outputs"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "capability_record_policy": { "type": "string", "minLength": 1 },
        "primary_entity_field": { "const": "entity_kind" },
        "no_primary_entity_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(block|command|construct)\\.[a-z0-9-]+$" }
        },
        "additional_entity_outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/additionalEntityOutput" }
        }
      }
    },
    "additionalEntityOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_ids", "entity_kind", "cardinality", "condition"],
      "properties": {
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(block|command|construct)\\.[a-z0-9-]+$" }
        },
        "entity_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "cardinality": { "enum": ["zero-or-one", "zero-or-more"] },
        "condition": { "type": "string", "minLength": 1 }
      }
    },
    "changeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation_impacts", "transformation_ids", "transformation_policy"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "operation_impacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operationImpact" }
        },
        "transformation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^transformation\\.[a-z0-9-]+$" }
        },
        "transformation_policy": { "type": "string", "minLength": 1 }
      }
    },
    "operationImpact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "capability_ids", "adapter", "direct_impacts", "dependent_checks"],
      "properties": {
        "operation": { "enum": ["create", "delete", "rename"] },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(block|command|construct)\\.[a-z0-9-]+$" }
        },
        "adapter": { "type": "string", "minLength": 1 },
        "direct_impacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependent_checks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "consumerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "read_routes", "mutation_routes"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "read_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/readRoute" }
        },
        "mutation_routes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mutationRoute" }
        }
      }
    },
    "readRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "scope", "consumers", "policy"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["parse", "semantic", "inspect", "static_validation"] }
        },
        "scope": { "const": "all-active-capabilities" },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "mutationRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "capability_ids", "tools", "adapter_kind", "policy"],
      "properties": {
        "operation": { "enum": ["modify", "create", "delete", "rename"] },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(block|command|construct)\\.[a-z0-9-]+$" }
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "adapter_kind": { "enum": ["parameter", "entity"] },
        "policy": { "type": "string", "minLength": 1 }
      }
    },
    "repositoryCheckContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "repository_command", "test_command", "ci_workflow",
        "required_checks", "optional_checks", "generated_artifacts", "ledger_policy"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "repository_command": { "const": "python tools/repository_checks.py" },
        "test_command": { "const": "python -m pytest -q" },
        "ci_workflow": { "const": ".github/workflows/verify.yml" },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "optional_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/optionalRepositoryCheck" }
        },
        "generated_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/generatedArtifact" }
        },
        "ledger_policy": { "type": "string", "minLength": 1 }
      }
    },
    "optionalRepositoryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      }
    },
    "generatedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "producer", "repository_check"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "repository_check": { "type": "string", "minLength": 1 }
      }
    },
    "generationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "profile_version", "status", "summary", "tool", "analysis",
        "mesh_format", "required_choices", "capabilities", "constraints", "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^generation\\.[a-z0-9.-]+$" },
        "profile_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "status": { "enum": ["implemented", "verified"] },
        "summary": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "analysis": { "type": "string", "minLength": 1 },
        "mesh_format": { "type": "string", "minLength": 1 },
        "required_choices": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        },
        "evidence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^evidence\\.[a-z0-9.-]+$" }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parse": { "$ref": "#/$defs/operationStatus" },
        "semantic": { "$ref": "#/$defs/operationStatus" },
        "inspect": { "$ref": "#/$defs/operationStatus" },
        "modify": { "$ref": "#/$defs/operationStatus" },
        "create": { "$ref": "#/$defs/operationStatus" },
        "delete": { "$ref": "#/$defs/operationStatus" },
        "rename": { "$ref": "#/$defs/operationStatus" },
        "reorder": { "$ref": "#/$defs/operationStatus" },
        "generate": { "$ref": "#/$defs/operationStatus" },
        "static_validation": { "$ref": "#/$defs/operationStatus" },
        "execute": { "$ref": "#/$defs/operationStatus" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "product_version",
        "source_commit",
        "executable_sha256",
        "platform",
        "execution_mode"
      ],
      "properties": {
        "product": { "const": "BSAM" },
        "product_version": { "type": "string" },
        "source_commit": { "type": "string", "pattern": "^[A-Fa-f0-9]{40}$" },
        "executable_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "platform": { "const": "windows" },
        "execution_mode": { "const": "serial" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation_syntax", "obsolete_syntax", "source_authority"],
      "properties": {
        "generation_syntax": { "const": "current-only" },
        "obsolete_syntax": { "const": "diagnostics-only" },
        "source_authority": { "const": "local-only" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "claim"],
      "properties": {
        "id": { "type": "string", "pattern": "^evidence\\.[a-z0-9.-]+$" },
        "kind": { "enum": ["source", "example", "runtime", "documentation"] },
        "locator": { "type": "string", "minLength": 1 },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "claim": { "type": "string", "minLength": 1 }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "tokens", "certainty"],
      "properties": {
        "style": { "enum": ["end-line", "record-sentinel", "command-and-end-line"] },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "certainty": { "enum": ["canonical", "accepted-current", "unresolved-canonical"] }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value_type", "required", "summary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value_type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "allowed_values": {
          "type": "array",
          "items": { "type": ["string", "number", "integer", "boolean"] }
        },
        "default": {},
        "cardinality": {
          "enum": ["single", "repeated-last-wins"]
        },
        "routing_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        },
        "edit_operations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "insert": { "$ref": "#/$defs/operationStatus" },
            "remove": { "$ref": "#/$defs/operationStatus" }
          }
        },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "termination", "variants", "dependencies"],
      "properties": {
        "style": { "enum": ["none", "single-record", "records", "nested-records", "repeated-record-groups"] },
        "termination": { "enum": ["next-command", "fixed-count", "next-command-or-eof", "next-top-level-block"] },
        "variants": {
          "type": "array",
          "items": { "$ref": "#/$defs/bodyVariant" }
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bodyVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "rows", "constraints"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/bodyRow" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bodyRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repetition", "fields"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repetition": { "enum": ["once", "repeated", "count-from-previous-field", "count-from-command-parameter", "one-or-more-until-next-type", "repeated-until-end-solver", "repeated-up-to-50"] },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/parameter" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical",
        "lookup_token",
        "match_rule",
        "required",
        "parser",
        "summary",
        "termination",
        "coverage",
        "parameters",
        "evidence_ids",
        "remaining_work"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^block\\.[a-z0-9-]+$" },
        "canonical": { "type": "string", "minLength": 1 },
        "lookup_token": { "type": "string", "minLength": 1 },
        "match_rule": { "enum": ["exact-case-sensitive", "special-input-scan"] },
        "required": { "type": "boolean" },
        "parser": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "entity_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "routing_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        },
        "termination": { "$ref": "#/$defs/termination" },
        "coverage": { "$ref": "#/$defs/coverage" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "remaining_work": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": { "$ref": "#/$defs/operations" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "nestedConstruct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_block_id",
        "canonical",
        "match_prefix",
        "kind",
        "summary",
        "coverage",
        "parameters",
        "evidence_ids",
        "remaining_work"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^construct\\.[a-z0-9-]+$" },
        "parent_block_id": { "type": "string", "pattern": "^block\\.[a-z0-9-]+$" },
        "canonical": { "type": "string", "minLength": 1 },
        "match_prefix": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["problem-start", "keyword", "record-group"] },
        "summary": { "type": "string", "minLength": 1 },
        "entity_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "routing_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        },
        "coverage": { "$ref": "#/$defs/coverage" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "remaining_work": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": { "$ref": "#/$defs/operations" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_block_id",
        "canonical",
        "dispatch_prefix",
        "summary",
        "coverage",
        "parameters",
        "evidence_ids",
        "remaining_work"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^command\\.[a-z0-9-]+$" },
        "parent_block_id": { "const": "block.clusters" },
        "canonical": { "type": "string", "pattern": "^\\*[A-Z][A-Z ]*$" },
        "dispatch_prefix": { "type": "string", "pattern": "^\\*[A-Z]{4}$" },
        "summary": { "type": "string", "minLength": 1 },
        "entity_kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "routing_terms": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        },
        "coverage": { "$ref": "#/$defs/coverage" },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "remaining_work": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "operations": { "$ref": "#/$defs/operations" },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "algorithm_version", "summary", "coverage", "tool", "operation",
        "applicability", "parameters", "decisions", "impacts", "dependencies",
        "evidence_ids"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^transformation\\.[a-z0-9-]+$" },
        "algorithm_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "summary": { "type": "string", "minLength": 1 },
        "coverage": { "$ref": "#/$defs/coverage" },
        "tool": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "applicability": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/applicabilityRule" }
        },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transformationDecision" }
        },
        "impacts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "applicabilityRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator", "value", "failure"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "contains-all", "same-labels", "same-topology", "within-tolerance"] },
        "value": {},
        "failure": { "type": "string", "minLength": 1 }
      }
    },
    "transformationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": {},
        "source": { "enum": ["user-approved", "source-derived"] }
      }
    },
    "obsoleteToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "replacement", "context", "behavior", "diagnostic", "evidence_ids"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "replacement": { "type": "string", "minLength": 1 },
        "context": { "enum": ["top-level-block", "top-level-terminator"] },
        "behavior": { "enum": ["not-accepted", "accepted-compatibility"] },
        "diagnostic": { "type": "string", "pattern": "^BSAM-W[0-9]{3}$" },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "executionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation",
        "input_extension",
        "success_policy",
        "control_files",
        "evidence_ids"
      ],
      "properties": {
        "invocation": { "type": "string", "minLength": 1 },
        "input_extension": { "const": ".in" },
        "success_policy": { "type": "string", "minLength": 1 },
        "control_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suffix", "role"],
            "properties": {
              "suffix": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 }
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    }
  }
}
